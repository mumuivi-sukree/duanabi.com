---
// src/components/DuaPagination.astro
interface Props {
  prevUrl?: string;
  nextUrl?: string;
}
const { prevUrl, nextUrl } = Astro.props;

/* 💡 แกะรหัสภาษาจาก URL เหมือนกับคอมโพเนนต์หลักเพื่อความแม่นยำ */
const pathname = Astro.url.pathname;
const segments = pathname.split('/').filter(Boolean);
const currentLang = segments[0] === 'ms' ? 'ms' : 'th';

// 💡 ชุดคำแปลของปุ่มระบบ
const labels = {
  th: {
    prev: "ก่อนหน้า",
    top: "บนสุด",
    next: "ถัดไป"
  },
  ms: {
    prev: "Sebelumnya",
    top: "Atas",
    next: "Seterusnya"
  }
};

const t = labels[currentLang];

// 💡 ฟังก์ชันช่วยจัดแจง URL: ถ้าอยู่หน้ามาเลย์ ให้เติม /ms นำหน้าลิงก์เสมอ (ยกเว้นลิงก์ภายนอกหรือมี /ms/ อยู่แล้ว)
const getLocalizedUrl = (url?: string) => {
  if (!url) return undefined;
  if (currentLang === 'ms' && !url.startsWith('/ms/')) {
    // ตัดสแลชตัวแรกออกถ้ามี เพื่อป้องกัน URL ซ้อนกันเป็น //ms//
    const cleanUrl = url.startsWith('/') ? url.slice(1) : url;
    return `/ms/${cleanUrl}`;
  }
  return url;
};

const finalPrevUrl = getLocalizedUrl(prevUrl);
const finalNextUrl = getLocalizedUrl(nextUrl);
---

<div class="grid grid-cols-3 gap-3 mt-12 pt-8 border-t border-slate-100">
  
  {/* ปุ่มก่อนหน้า */}
  {finalPrevUrl ? (
    <a href={finalPrevUrl} class="flex items-center justify-center gap-1 py-3 px-2 bg-blue-600 rounded-xl !text-white font-bold no-underline hover:bg-blue-800 transition-all text-xs shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      {t.prev}
    </a>
  ) : <div />}

  {/* ปุ่มกลับไปบนสุด */}
  <button 
    onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
    class="flex items-center justify-center gap-1 py-3 px-2 bg-slate-200 rounded-xl !text-slate-700 font-bold border border-slate-200 hover:bg-slate-400 transition-all text-xs cursor-pointer"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
    {t.top}
  </button>

  {/* ปุ่มหน้าถัดไป */}
  {finalNextUrl ? (
    <a href={finalNextUrl} class="flex items-center justify-center gap-1 py-3 px-2 bg-blue-600 rounded-xl !text-white font-bold no-underline hover:bg-blue-800 transition-all text-xs shadow-sm">
      {t.next}
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </a>
  ) : <div />}

</div>