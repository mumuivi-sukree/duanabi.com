---
// src/components/StartButton.astro

// 💡 ดักจับภาษาจาก URL ปัจจุบัน
const pathname = Astro.url.pathname;
const isMalay = pathname.startsWith('/ms/') || pathname === '/ms';

// สลับข้อความและลิงก์ปลายทางให้ตรงตามภาษาของหน้าแรกที่กำลังเปิดอยู่
const buttonText = isMalay ? "Mula Membaca Doa" : "เริ่มอ่านดุอาอ์";
const targetUrl = isMalay ? "/ms/parents/parents01/" : "/parents/parents01/";
---

<div class="md:hidden flex justify-center my-10">
  <button 
    id="start-guide-btn"
    data-target-url={targetUrl}
    class="group px-8 py-4 bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-bold text-xl rounded-2xl shadow-[0_10px_20px_rgba(249,115,22,0.3)] transition-all duration-300 hover:shadow-orange-500/40 transform hover:-translate-y-1 active:scale-95 flex items-center gap-3 cursor-pointer"
  >
    <span>{buttonText}</span>
    <div class="bg-white/20 p-1 rounded-lg group-hover:bg-white/30 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 5l7 7-7 7M5 5l7 7-7 7\" />
      </svg>
    </div>
  </button>
</div>

<script is:inline>
  (function() {
    const setupStartBtn = () => {
      const startBtn = document.getElementById('start-guide-btn');
      if (!startBtn) return;

      startBtn.onclick = (e) => {
        e.preventDefault();
        // ดึงค่าลิงก์ปลายทางตามภาษาที่สลับไว้จาก data attribute
        const url = startBtn.getAttribute('data-target-url');
        if (url) {
          window.location.href = url;
        }
      };
    };

    setupStartBtn();
    document.addEventListener('astro:after-swap', setupStartBtn);
  })();
</script>