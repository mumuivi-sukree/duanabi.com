---
import { getCollection } from 'astro:content';

// ดึงข้อมูลทั้งหมดจาก docs
const allDocs = await getCollection('docs');

// กรองเอาเฉพาะไฟล์ที่ไม่ใช่หน้าแรก (index.mdx) เพื่อให้นับแค่บทดุอาอ์จริงๆ
const duaCount = allDocs.filter(doc => doc.id !== 'index.mdx').length;
---

<div class="bg-orange-50 border border-orange-100 rounded-2xl p-6 my-8 text-center shadow-sm">
  <div class="text-gray-600 text-sm mb-1 font-medium">รวมบทดุอาอ์ที่รวบรวมแล้ว</div>
  <div class="text-4xl font-bold text-orange-600 mb-1">
    {duaCount}
  </div>
  <div class="text-gray-500 text-2xl">บท </div>
  <div class="text-gray-500 text-1xl">เราจะยังคงหาบทดุอาอ์มาลงในเพจเรื่อยๆ<br> โปรดติดตาม อินชาอัลลอฮฺ</div>
</div>